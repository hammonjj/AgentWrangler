<?xml version="1.0" encoding="UTF-8"?>
<!--
  Entitlements for the local macOS build.

  The first three are what any Electron app needs: V8 compiles at runtime, and
  the helper processes load frameworks the bundle signature does not cover.

  The last one is dictation. Recording goes through an `ffmpeg` child process
  rather than the renderer — `webkitSpeechRecognition` was ruled out long ago
  and fails inside any Electron-based webview, VSCode's included — and macOS
  attributes a child's microphone use to the app that spawned it, so the
  entitlement belongs here rather than nowhere.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
