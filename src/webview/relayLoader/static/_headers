# Netlify response headers for the remote-control loader (#175; plan §1.2, §5).
# Script and style only from this site, or from blob: URLs the loader makes out of the
# workbench files the Mac sent over the encrypted relay. Network only to Supabase.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' blob:; style-src 'self' blob:; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), geolocation=(), microphone=(self)
  Cache-Control: no-cache
