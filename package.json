{
  "name": "agent-wrangler",
  "displayName": "Agent Wrangler",
  "description": "Monitor Claude Code and Codex sessions: who is busy, waiting on you, or done. Run and open live conversations from a browser.",
  "publisher": "local",
  "version": "0.0.1",
  "private": true,
  "categories": [
    "Other"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "app:package": "npm run build && node scripts/fetch-node.mjs && esbuild scripts/package-app.ts --bundle --platform=node --format=cjs --log-level=warning --outfile=release/.package-app.cjs && node release/.package-app.cjs",
    "app:install": "npm run app:package && bash scripts/install-app.sh",
    "app:signing-setup": "bash scripts/setup-signing-cert.sh",
    "cli:install": "bash scripts/install-cli.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench:analytics": "esbuild scripts/bench-analytics.ts --bundle --platform=node --log-level=warning --outfile=/tmp/aw-bench-analytics.cjs && node --expose-gc /tmp/aw-bench-analytics.cjs",
    "test:integration": "vitest run test/sessionHost.integration.test.ts test/sessionLifecycle.integration.test.ts"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.268",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^24.0.0",
    "@types/ws": "8.18.2",
    "esbuild": "^0.25.0",
    "markdown-it": "15.0.2",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0",
    "ws": "8.22.0"
  }
}
